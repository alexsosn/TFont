{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfont.dev/schema/v1/review.schema.json",
  "type": "object",
  "required": ["review_id", "status", "reviewed_mapping_digest", "reviewer_id", "reviewed_at", "review_source", "review_method"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["reviewed", "provisional", "disputed"]},
    "reviewed_mapping_digest": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "review_source": {"type": "string", "minLength": 1},
    "review_method": {"type": "string", "minLength": 1},
    "notes": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
