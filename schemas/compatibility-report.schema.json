{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfont.dev/schema/v1/compatibility-report.schema.json",
  "type": "object",
  "required": ["compatibility_report_id", "report_digest", "profile_id", "profile_version", "profile_semantic_digest", "expected_parent_manifest_digest", "observed_parent_manifest_digest", "state", "changed_components", "dependency_results", "evaluator_version", "incomplete_reasons", "failure_reasons"],
  "properties": {
    "compatibility_report_id": {"type": "string", "minLength": 1},
    "report_digest": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "profile_semantic_digest": {"type": "string", "minLength": 1},
    "expected_parent_manifest_digest": {"type": "string", "minLength": 1},
    "observed_parent_manifest_digest": {"type": "string", "minLength": 1},
    "state": {"enum": ["verified-exact", "verified-compatible", "unverified", "incompatible"]},
    "changed_components": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dependency_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dependency_id", "component_id", "result", "evaluator_rule_version"],
        "properties": {
          "dependency_id": {"type": "string", "minLength": 1},
          "component_id": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "unknown"]},
          "observed_evidence_digest": {"type": "string", "minLength": 1},
          "observed_summary": {},
          "evaluator_rule_version": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "evaluator_version": {"type": "string", "minLength": 1},
    "incomplete_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "failure_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "generated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
