{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfont.dev/schema/v1/ontology-lock.schema.json",
  "type": "object",
  "required": ["lock_id", "ontology_id", "support_tier", "term_namespace", "release", "source_uri", "content_digest", "license", "snapshot_artifact", "terms_used"],
  "properties": {
    "lock_id": {"type": "string", "minLength": 1},
    "ontology_id": {"type": "string", "minLength": 1},
    "support_tier": {"type": "string", "minLength": 1},
    "term_namespace": {"type": "string", "minLength": 1},
    "release": {"type": "string", "minLength": 1},
    "upstream_release_status": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "content_digest": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "redistribution_policy": {"type": "string", "minLength": 1},
    "snapshot_artifact": {"type": "string", "minLength": 1},
    "terms_used": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
