{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfont.dev/schema/v1/mapping.schema.json",
  "$defs": {
    "evidenceBinding": {
      "type": "object",
      "required": ["evidence_id", "content_digest"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "content_digest": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["review_id", "status", "reviewed_mapping_digest", "reviewer_id", "reviewed_at", "review_source", "review_method"],
      "properties": {
        "review_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["reviewed", "provisional", "disputed"]},
        "reviewed_mapping_digest": {"type": "string", "minLength": 1},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 1},
        "review_source": {"type": "string", "minLength": 1},
        "review_method": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["external_target", "ontology_lock", "assessment_candidate", "evidence"],
      "properties": {
        "external_target": {"type": "string", "minLength": 1},
        "ontology_lock": {"type": "string", "minLength": 1},
        "assessment_candidate": {"enum": ["exact", "close", "broader", "narrower", "related"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceBinding"}}
      },
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "required": ["mapping_id", "profile_id", "native_selector", "native_dependencies", "external_target", "candidate_projections", "assessment", "publication_relation", "applicability", "ontology_lock", "evidence", "review", "mapping_semantic_digest", "rationale"],
      "properties": {
        "mapping_id": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "native_selector": {"type": "object", "minProperties": 1},
        "native_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "external_target": {"type": ["string", "null"], "minLength": 1},
        "candidate_projections": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "assessment": {"enum": ["exact", "close", "broader", "narrower", "related", "ambiguous", "native-only", "unsupported"]},
        "publication_relation": {"type": ["string", "null"]},
        "applicability": {"type": "object"},
        "ontology_lock": {"type": ["string", "null"], "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidenceBinding"}},
        "review": {"$ref": "#/$defs/review"},
        "mapping_semantic_digest": {"type": "string", "minLength": 1},
        "rationale": {"type": "string"},
        "introduced_in": {"type": "string", "minLength": 1},
        "changed_in": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"assessment": {"enum": ["exact", "close", "broader", "narrower", "related"]}}},
          "then": {
            "properties": {
              "external_target": {"type": "string", "minLength": 1},
              "ontology_lock": {"type": "string", "minLength": 1},
              "candidate_projections": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"assessment": {"const": "ambiguous"}}},
          "then": {
            "properties": {
              "external_target": {"type": "null"},
              "ontology_lock": {"type": "null"},
              "publication_relation": {"type": "null"},
              "candidate_projections": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"assessment": {"enum": ["native-only", "unsupported"]}}},
          "then": {
            "properties": {
              "external_target": {"type": "null"},
              "ontology_lock": {"type": "null"},
              "publication_relation": {"type": "null"},
              "candidate_projections": {"maxItems": 0}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "mappings"],
  "properties": {
    "schema_version": {"const": 1},
    "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}}
  },
  "additionalProperties": false
}
