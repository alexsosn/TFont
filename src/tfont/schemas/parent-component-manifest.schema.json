{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfont.dev/schema/v1/parent-component-manifest.schema.json",
  "type": "object",
  "required": ["algorithm", "components"],
  "properties": {
    "algorithm": {"const": "tfont-parent-components-sha256-v1"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component_id", "kind", "identity_algorithm", "content_digest"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["tf-payload", "sidecar", "catalogue", "zero-span", "native-adapter"]},
          "identity_algorithm": {"type": "string", "minLength": 1},
          "content_digest": {"type": "string", "minLength": 1},
          "logical_locator": {"type": "string", "minLength": 1},
          "license_ref": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
