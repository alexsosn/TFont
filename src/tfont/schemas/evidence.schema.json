{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfont.dev/schema/v1/evidence.schema.json",
  "type": "object",
  "required": ["evidence_id", "kind", "source_uri", "content_mode", "content_digest"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "content_mode": {"enum": ["external-payload", "normalized-record"]},
    "reviewed_content": {},
    "content_digest": {"type": "string", "minLength": 1},
    "license_ref": {"type": "string", "minLength": 1},
    "citation": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"content_mode": {"const": "external-payload"}}},
      "then": {"not": {"required": ["reviewed_content"]}}
    },
    {
      "if": {"properties": {"content_mode": {"const": "normalized-record"}}},
      "then": {"required": ["reviewed_content"]}
    }
  ],
  "additionalProperties": false
}
